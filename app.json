{
  "expo": {
    "name": "torombolo",
    "slug": "torombolo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/tapete/Tapete1.png",
    "scheme": "torombolo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/tapete/Tapete1.png",
        "backgroundImage": "./assets/tapete/Tapete1.png",
        "monochromeImage": "./assets/tapete/Tapete1.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sherco2008.torombolo"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/tapete/Tapete1.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/tapete/Tapete1.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f5b152d0-add9-4c95-999a-133c08351d06"
      }
    }
  }
}
